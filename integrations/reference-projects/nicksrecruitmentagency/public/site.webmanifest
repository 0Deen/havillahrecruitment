{
  "name": "Nicks Recruitment Agency",
  "short_name": "Nicks Recruitment",
  "description": "Nicks Recruitment Agency is a licensed recruitment agency in Kenya connecting skilled professionals with verified employers locally and internationally. We specialize in overseas jobs, Gulf jobs, healthcare recruitment, hospitality recruitment, engineering recruitment, construction recruitment, domestic worker recruitment, visa processing, medical screening, pre-departure training and career guidance.",

  "start_url": "/",
  "id": "/",
  "scope": "/",

  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],

  "orientation": "portrait-primary",

  "background_color": "#ffffff",
  "theme_color": "#0F4C81",

  "lang": "en",
  "dir": "ltr",

  "categories": [
    "business",
    "employment",
    "jobs",
    "recruitment",
    "career",
    "education"
  ],

  "prefer_related_applications": false,

  "icons": [
    {
      "src": "/logo.jpg",
      "sizes": "1200x630",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "/favicon.ico",
      "sizes": "48x48",
      "type": "image/x-icon"
    }
  ],


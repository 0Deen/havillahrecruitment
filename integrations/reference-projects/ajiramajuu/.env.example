# OpenAI (server-side only — never expose in frontend)
OPENAI_API_KEY=

# Resend (server-side only — never expose in frontend)
RESEND_API_KEY=
# IMPORTANT: this address's domain must be a domain you've verified inside
# your Resend dashboard (Resend > Domains). If you verify ajiramajuu.com
# there, RESEND_FROM_EMAIL must end in @ajiramajuu.com — not .co.ke, not
# gmail.com, not any other domain, or every send will fail silently.
# Until a domain is verified, Resend only lets you send to the email address
# on your own Resend account (useful for testing, not for production).
RESEND_FROM_EMAIL=notifications@ajiramajuu.com
# Comma-separate multiple recipients to notify everyone at once.
AJIRA_MAJUU_NOTIFICATION_EMAIL=deen@ajiramajuu.com

# WhatsApp notifications (optional — leave blank and the site runs fine
# without them; see lib/whatsapp.ts for setup). Uses Twilio's WhatsApp API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
AJIRA_MAJUU_WHATSAPP_TO=whatsapp:+254115614253

# Optional: simple in-memory rate limit window (ms) and max requests
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20

# Public site URL (used for canonical URLs, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://ajiramajuu.com
